generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Tenancy & identity ───────────────────────────

model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  timezone      String   @default("Asia/Kolkata")
  senderName    String? // default "Krishna"
  senderCompany String? // default "Concilio"
  companyBlurb  String?  @db.Text // what we sell — fed to the AI writer

  // ── Phase 10: commercial readiness (billing provider integration deliberately deferred — Section 12) ──
  plan               String   @default("free") // free | pro | ... — a name into PLAN_LIMITS (src/lib/usage/plans.ts), never a price
  subscriptionStatus String   @default("active") // active | past_due | canceled | trialing — state only, no payment provider wired up yet
  quotaOverrides     Json?    // optional per-workspace override of PLAN_LIMITS, e.g. {"agent_task": 5000} — null means "use the plan's defaults"
  featureFlags       Json     @default("{}") // per-workspace feature toggles, checked via src/lib/usage/plans.ts's hasFeature()

  createdAt DateTime @default(now())

  members      Membership[]
  mailboxes    Mailbox[]
  waInstances  WaInstance[]
  lists        LeadList[]
  leads        Lead[]
  campaigns    Campaign[]
  messages     Message[]
  templates    Template[]
  suppressions Suppression[]
  jobs         Job[]
  apiKeys      ApiKey[]
  usageEvents  UsageEvent[]

  agents           Agent[]
  agentTasks       AgentTask[]
  approvals        Approval[]
  approvalPolicies ApprovalPolicy[]
  agentActivity    AgentActivityLog[]

  smsGateways SmsGateway[]

  mediaAssets     MediaAsset[]
  mediaAnalyses   MediaAnalysis[]
  knowledgeChunks KnowledgeChunk[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]

  createdTasks     AgentTask[] @relation("TaskCreatedBy")
  decidedApprovals Approval[]  @relation("ApprovalDecidedBy")
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("owner") // owner | admin | member
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  hash        String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Channels: email ───────────────────────────

model Mailbox {
  id          String  @id @default(cuid())
  workspaceId String
  label       String
  fromName    String
  fromEmail   String
  replyTo     String?
  provider    String // smtp | resend | gmail_oauth | outlook_oauth
  status      String  @default("active") // active | paused | error

  // SMTP
  smtpHost    String?
  smtpPort    Int?
  smtpSecure  Boolean @default(true)
  smtpUser    String?
  smtpPassEnc String? // encrypted at rest

  // API / OAuth
  apiKeyEnc       String?
  oauthAccessEnc  String?
  oauthRefreshEnc String?
  oauthExpiresAt  DateTime?

  // Deliverability governor
  dailyLimit    Int       @default(50) // hard cap per 24h
  warmupEnabled Boolean   @default(true)
  warmupStart   Int       @default(10) // day-1 volume
  warmupStep    Int       @default(5) // +N per day
  minGapSeconds Int       @default(90) // throttle between sends
  jitterSeconds Int       @default(45) // random extra delay
  sentToday     Int       @default(0)
  sentTodayDate String? // yyyy-mm-dd in workspace tz
  lastSentAt    DateTime?
  activatedAt   DateTime  @default(now())
  lastError     String?   @db.Text

  createdAt DateTime  @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId, status])
}

// ─────────────────────────── Channels: whatsapp ───────────────────────────

model WaInstance {
  id            String    @id @default(cuid())
  workspaceId   String
  label         String
  instanceName  String    @unique // Evolution API instance name
  number        String?
  status        String    @default("disconnected") // disconnected | qr | connected | error
  tokenEnc      String?
  dailyLimit    Int       @default(150)
  minGapSeconds Int       @default(45)
  jitterSeconds Int       @default(30)
  sentToday     Int       @default(0)
  sentTodayDate String?
  lastSentAt    DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([workspaceId, status])
}

// ─────────────────────────── Channels: sms ───────────────────────────

/**
 * A workspace's connection to an SMS gateway. The customer's own Android
 * phone/SIM does the actual telecom transmission (httpSMS today) — this row
 * only ever represents "are we able to reach that device through the
 * provider's API", never a guarantee of carrier delivery. See
 * docs/sms-integration.md for the full connected-vs-delivered distinction.
 */
model SmsGateway {
  id          String  @id @default(cuid())
  workspaceId String
  label       String
  provider    String  @default("httpsms") // httpsms | ... (future: a real gateway provider)
  phoneNumber String // the "from" number registered with the provider — the customer's own device/SIM, not ours
  apiKeyEnc   String? // encrypted at rest, same as Mailbox.smtpPassEnc / WaInstance.tokenEnc
  status      String  @default("disconnected") // not_configured | disconnected | connected | error

  dailyLimit    Int       @default(50)
  minGapSeconds Int       @default(30)
  jitterSeconds Int       @default(15)
  sentToday     Int       @default(0)
  sentTodayDate String?
  lastSentAt    DateTime?
  lastError     String?   @db.Text

  createdAt DateTime  @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId, status])
}

// ─────────────────────────── Leads ───────────────────────────

model LeadList {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  sourceFile  String?
  filePath    String?
  sheetName   String?
  sheets      Json? // preview of EVERY sheet found in the workbook
  columnMap   Json? // canonical field -> source header
  headers     Json? // all source headers, in order
  rowCount    Int        @default(0)
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads       Lead[]
  campaigns   Campaign[]
}

model Lead {
  id          String @id @default(cuid())
  workspaceId String
  listId      String

  // canonical fields — auto-extracted from the sheet
  firstName String?
  lastName  String?
  fullName  String?
  email     String?
  phone     String?
  company   String?
  title     String?
  industry  String?
  city      String?
  country   String?
  website   String?
  linkedin  String?

  // everything else from the sheet, verbatim, keyed by header
  custom Json @default("{}")

  // enrichment / segmentation
  tier  String?
  score Int?
  tags  String[] @default([])

  status     String  @default("new") // new | queued | contacted | replied | bounced | unsubscribed | invalid
  emailValid Boolean @default(true)
  dedupeKey  String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      LeadList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  messages  Message[]
  drafts    Draft[]

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status])
  @@index([listId])
}

// ─────────────────────────── Campaigns ───────────────────────────

model Campaign {
  id          String  @id @default(cuid())
  workspaceId String
  listId      String?
  name        String
  channel     String  @default("email") // email | whatsapp | both
  status      String  @default("draft") // draft | scheduled | running | paused | done

  // AI writer configuration
  aiEnabled  Boolean @default(false)
  aiPurpose  String? @db.Text // "what am I mailing them about"
  aiTone     String  @default("direct, warm, no fluff")
  aiLanguage String  @default("English")
  aiMaxWords Int     @default(120)
  aiCta      String? @db.Text
  aiModel    String?

  // sending window (workspace timezone)
  sendDays        Int[]  @default([1, 2, 3, 4, 5])
  sendStartHour   Int    @default(9)
  sendEndHour     Int    @default(18)
  timezone        String @default("Asia/Kolkata")
  perLeadGapHours Int    @default(0)

  trackOpens  Boolean @default(true)
  trackClicks Boolean @default(true)
  stopOnReply Boolean @default(true)

  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      LeadList?      @relation(fields: [listId], references: [id])
  steps     CampaignStep[]
  messages  Message[]
  drafts    Draft[]
}

model CampaignStep {
  id         String   @id @default(cuid())
  campaignId String
  order      Int
  channel    String   @default("email") // email | whatsapp
  delayDays  Int      @default(0) // wait after previous step
  subject    String?  @db.Text
  body       String   @db.Text
  condition  String   @default("no_reply") // always | no_reply | no_open
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, order])
}

// AI-written, per-lead, reviewable BEFORE anything is sent
model Draft {
  id         String   @id @default(cuid())
  campaignId String
  leadId     String
  stepOrder  Int      @default(1)
  channel    String   @default("email")
  subject    String?  @db.Text
  body       String   @db.Text
  model      String?
  approved   Boolean  @default(false)
  edited     Boolean  @default(false)
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId, stepOrder])
}

// ─────────────────────────── Messages & events ───────────────────────────

model Message {
  id           String  @id @default(cuid())
  workspaceId  String
  campaignId   String?
  leadId       String
  mailboxId    String?
  waInstanceId String?
  smsGatewayId String?
  agentTaskId  String? // set when an AI agent proposed this message (via Approval) rather than a human campaign
  stepOrder    Int     @default(1) // 0 = an agent-proposed one-off action, not a campaign step
  channel      String  @default("email") // email | whatsapp | sms

  toAddress String
  subject   String? @db.Text
  body      String  @db.Text

  status     String  @default("queued") // queued | sent | failed | bounced | skipped
  providerId String?
  error      String? @db.Text

  scheduledFor DateTime  @default(now())
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  repliedAt    DateTime?
  bouncedAt    DateTime?

  trackingId String   @unique
  createdAt  DateTime @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailbox    Mailbox?    @relation(fields: [mailboxId], references: [id])
  waInstance WaInstance? @relation(fields: [waInstanceId], references: [id])
  smsGateway SmsGateway? @relation(fields: [smsGatewayId], references: [id])
  agentTask  AgentTask?  @relation(fields: [agentTaskId], references: [id])
  approval   Approval?
  events     Event[]

  @@index([status, scheduledFor])
  @@index([campaignId, status])
  @@index([agentTaskId])
}

model Event {
  id        String   @id @default(cuid())
  messageId String
  type      String // open | click | reply | bounce | complaint | unsubscribe | delivered
  meta      Json?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, type])
}

model Suppression {
  id          String    @id @default(cuid())
  workspaceId String
  value       String // email or phone, lowercased
  kind        String    @default("email") // email | phone | domain
  reason      String    @default("unsubscribed")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, value])
}

model Template {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  channel     String    @default("email")
  subject     String?   @db.Text
  body        String    @db.Text
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Usage ───────────────────────────

/**
 * One append-only ledger for every metric worth billing or capping later
 * (ai_request, ai_tokens today; agent/task/message counters land here too as
 * those features ship) rather than a table per metric. `kind` + `meta` carry
 * the shape; aggregation is a GROUP BY, not a schema change.
 */
model UsageEvent {
  id          String    @id @default(cuid())
  workspaceId String
  kind        String // ai_request | ai_tokens | ...
  quantity    Int       @default(1)
  meta        Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, createdAt])
}

// ─────────────────────────── AI Workforce ───────────────────────────

/**
 * These four are named-value fields the rest of the codebase leaves as plain,
 * comment-documented strings (see Campaign.status, Message.status, etc.) —
 * validated only by whatever UI happens to constrain them. That convention is
 * deliberately not followed here: autonomy level and task status gate whether
 * an AI agent is allowed to act unattended, so an invalid or mistyped value
 * failing at the database, not just in a form, is the point.
 */
enum AutonomyLevel {
  SuggestOnly
  DraftAndRequestApproval
  ExecuteApprovedActions
  Autonomous
}

enum TaskStatus {
  Queued
  Thinking
  Working
  WaitingForInput
  WaitingForApproval
  Completed
  Failed
  Cancelled
}

/**
 * Shared by AgentTask.approvalState (does this task need one, and where is it)
 * and Approval.status (the decision on one specific proposed action).
 */
enum ApprovalState {
  None
  Pending
  Approved
  Rejected
}

/**
 * A remembered answer for future approvals of the same agent + actionType.
 */
enum PolicyDecision {
  AutoApprove
  AutoReject
}

model Agent {
  id           String  @id @default(cuid())
  workspaceId  String
  name         String
  role         String // job title, e.g. "CEO / Strategy", "Research" — not Membership.role
  department   String?
  objective    String? @db.Text
  instructions String? @db.Text // the system prompt

  allowedTools  Json          @default("[]") // tool names this agent may call — enforced at execution, not just here
  autonomyLevel AutonomyLevel @default(SuggestOnly) // never Autonomous by default
  status        String        @default("active") // active | paused | archived
  // Reserved per-agent settings knob (Phase 2 extensibility, e.g. a future
  // channel-specific override or rate tweak scoped to one agent rather than
  // the whole workspace) — write/patch path exists (agents.ts), no reader
  // yet. Same "add the field before the first concrete use" pattern as
  // AgentTask.relatedRecordIds, which Phase 7's Command Center later did put
  // to real use (dependency edges) — kept for the same reason, not reflexively.
  config        Json          @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     AgentTask[]
  approvals Approval[]
  policies  ApprovalPolicy[]
  activity  AgentActivityLog[]

  @@index([workspaceId, status])
}

model AgentTask {
  id           String  @id @default(cuid())
  workspaceId  String
  agentId      String
  parentTaskId String? // set for a delegated sub-task; depth is capped in application code

  title       String
  description String?    @db.Text
  priority    Int        @default(1) // 0=low 1=normal 2=high 3=urgent
  status      TaskStatus @default(Queued)

  input            Json?
  output           Json?
  relatedRecordIds Json          @default("[]") // heterogeneous ids (leads, campaigns, ...), not a single FK
  approvalState    ApprovalState @default(None)

  createdBy     String? // a User id; null when the task was created by agent delegation, not a human
  retries       Int     @default(0)
  maxRetries    Int     @default(3)
  failureReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent      Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parentTask AgentTask?         @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   AgentTask[]        @relation("TaskSubtasks")
  creator    User?              @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  approvals  Approval[]
  activity   AgentActivityLog[]
  messages   Message[]

  @@index([workspaceId, status])
  @@index([agentId, status])
  @@index([parentTaskId])
}

model Approval {
  id                String        @id @default(cuid())
  taskId            String
  agentId           String
  workspaceId       String
  actionType        String // e.g. send_email | send_whatsapp | send_sms | launch_campaign | delete_data
  proposedContent   Json
  // A stable, actionType-independent answer to "which real records would
  // this affect" — proposedContent's shape differs per actionType (an
  // outreach send vs. a future launch_campaign/delete_data proposal), so a
  // future generic approvals-list UI that wants to link out to affected
  // records for ANY actionType needs one shape it can always read, not one
  // parser per actionType. Populated by outreach.ts ([lead.id]) since Phase 6;
  // no reader yet — today's Approvals UI reads proposedContent directly
  // because outreach is still the only actionType family that exists.
  affectedRecordIds Json          @default("[]")
  status            ApprovalState @default(Pending)
  decidedBy         String? // a User id
  decidedAt         DateTime?
  // Set once an Approved outreach action materializes a real Message — the
  // idempotency guard against creating a second Message for one approval,
  // and the queryable link from "what was approved" to "what actually sent".
  messageId         String?       @unique
  createdAt         DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  decider   User?     @relation("ApprovalDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)
  message   Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([taskId])
}

model ApprovalPolicy {
  id          String         @id @default(cuid())
  workspaceId String
  agentId     String
  actionType  String
  decision    PolicyDecision
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, agentId, actionType])
}

model AgentActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String
  taskId      String? // set when the event happened in the course of a task; absent for e.g. "agent created"
  type        String // task_created | task_status_changed | tool_called | approval_requested | approval_decided | agent_created | agent_updated | ...
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task      AgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([agentId, createdAt])
  @@index([taskId])
}

// DB-backed job queue — no Redis needed for v1
model Job {
  id          String    @id @default(cuid())
  workspaceId String
  type        String // send_message | generate_drafts | sync_wa_status | run_agent_task | process_media
  payload     Json
  status      String    @default("pending") // pending | running | done | failed
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.Text
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}

// ── Phase 9: web/social research ────────────────────────────────────────────

/**
 * A fetched-and-extracted public web page, keyed by normalized URL — not
 * workspace-scoped (a public page's clean text is the same fact for every
 * workspace, and re-fetching it per workspace would defeat the point of a
 * cache). Only ever holds what WebFetchService actually retrieved from a
 * public URL; never used for anything gated behind a login wall.
 */
model ResearchCache {
  id              String   @id @default(cuid())
  normalizedUrl   String   @unique
  contentHash     String // sha256 of the raw fetched body — lets a caller detect "did this page actually change" without re-extracting
  extraction      Json // { title, textContent, excerpt, byline, length }
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime // TTL enforced in application code (cache.ts), not a DB job — see RESEARCH_CACHE_TTL_MS

  @@index([expiresAt])
}

/**
 * An uploaded file (a Reel/video, for now) pending or already processed by
 * the media-analysis pipeline. `storagePath` is a key into the storage
 * abstraction (src/lib/storage/), not a raw filesystem path — local-disk
 * today, swappable for R2 without touching this model.
 */
model MediaAsset {
  id          String   @id @default(cuid())
  workspaceId String
  uploadedBy  String // a User id
  filename    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analyses  MediaAnalysis[]

  @@index([workspaceId])
}

/**
 * One research/analysis run — either an uploaded MediaAsset or a social/web
 * URL. Async by design (see docs/research.md "Async media processing"):
 * the analyze_uploaded_media tool creates this row and enqueues a Job, then
 * returns immediately; the worker's process_media handler fills in `result`.
 */
model MediaAnalysis {
  id           String   @id @default(cuid())
  workspaceId  String
  agentId      String?
  taskId       String?
  mediaAssetId String?
  sourceUrl    String?
  sourceType   String // upload | social_url | web_url
  status       String   @default("queued") // queued | processing | completed | failed
  result       Json? // structured findings once completed — schema documented in docs/research.md
  error        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

/**
 * Explicit-only research storage (Section 10: "do not automatically put
 * every web result into long-term memory") — plain chunked text, searched by
 * Postgres full-text search (`search_knowledge` tool). No embeddings/vector
 * index yet; see docs/research.md's "Known limitations" for the upgrade path
 * once an embedding-capable provider is configured.
 */
model KnowledgeChunk {
  id          String   @id @default(cuid())
  workspaceId String
  sourceUrl   String?
  sourceType  String // web | social | media | manual
  chunkIndex  Int
  content     String   @db.Text
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sourceUrl])
}

/**
 * Rate-limits src/app/login/page.tsx — the one endpoint with no session yet,
 * so nothing else in the app gates it. One row per identifier
 * ("email:x@y.com" or "ip:1.2.3.4"); a fixed window starting at windowStart,
 * reset once it's older than the configured window (src/lib/auth/rateLimit.ts).
 * DB-backed rather than an in-memory Map so the limit holds across process
 * restarts and would still hold if this service ever ran as more than one
 * instance — an in-memory counter is private per instance and would
 * silently multiply the real limit instead of enforcing it.
 */
model LoginAttempt {
  identifier  String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
}
