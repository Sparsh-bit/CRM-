generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Tenancy & identity ───────────────────────────

model Workspace {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  timezone      String    @default("Asia/Kolkata")
  senderName    String?   // default "Krishna"
  senderCompany String?   // default "Concilio"
  companyBlurb  String?   @db.Text // what we sell — fed to the AI writer
  plan          String    @default("free")
  createdAt     DateTime  @default(now())

  members     Membership[]
  mailboxes   Mailbox[]
  waInstances WaInstance[]
  lists       LeadList[]
  leads       Lead[]
  campaigns   Campaign[]
  messages    Message[]
  templates   Template[]
  suppressions Suppression[]
  jobs        Job[]
  apiKeys     ApiKey[]
  usageEvents UsageEvent[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("owner") // owner | admin | member
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  hash        String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Channels: email ───────────────────────────

model Mailbox {
  id          String  @id @default(cuid())
  workspaceId String
  label       String
  fromName    String
  fromEmail   String
  replyTo     String?
  provider    String  // smtp | resend | gmail_oauth | outlook_oauth
  status      String  @default("active") // active | paused | error

  // SMTP
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean @default(true)
  smtpUser     String?
  smtpPassEnc  String? // encrypted at rest

  // API / OAuth
  apiKeyEnc       String?
  oauthAccessEnc  String?
  oauthRefreshEnc String?
  oauthExpiresAt  DateTime?

  // Deliverability governor
  dailyLimit     Int      @default(50)   // hard cap per 24h
  warmupEnabled  Boolean  @default(true)
  warmupStart    Int      @default(10)   // day-1 volume
  warmupStep     Int      @default(5)    // +N per day
  minGapSeconds  Int      @default(90)   // throttle between sends
  jitterSeconds  Int      @default(45)   // random extra delay
  sentToday      Int      @default(0)
  sentTodayDate  String?                 // yyyy-mm-dd in workspace tz
  lastSentAt     DateTime?
  activatedAt    DateTime @default(now())
  lastError      String?  @db.Text

  createdAt DateTime  @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId, status])
}

// ─────────────────────────── Channels: whatsapp ───────────────────────────

model WaInstance {
  id           String    @id @default(cuid())
  workspaceId  String
  label        String
  instanceName String    @unique  // Evolution API instance name
  number       String?
  status       String    @default("disconnected") // disconnected | qr | connected | error
  tokenEnc     String?
  dailyLimit   Int       @default(150)
  minGapSeconds Int      @default(45)
  jitterSeconds Int      @default(30)
  sentToday    Int       @default(0)
  sentTodayDate String?
  lastSentAt   DateTime?
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([workspaceId, status])
}

// ─────────────────────────── Leads ───────────────────────────

model LeadList {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  sourceFile   String?
  filePath     String?
  sheetName    String?
  sheets       Json?     // preview of EVERY sheet found in the workbook
  columnMap    Json?     // canonical field -> source header
  headers      Json?     // all source headers, in order
  rowCount     Int       @default(0)
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads        Lead[]
  campaigns    Campaign[]
}

model Lead {
  id          String  @id @default(cuid())
  workspaceId String
  listId      String

  // canonical fields — auto-extracted from the sheet
  firstName String?
  lastName  String?
  fullName  String?
  email     String?
  phone     String?
  company   String?
  title     String?
  industry  String?
  city      String?
  country   String?
  website   String?
  linkedin  String?

  // everything else from the sheet, verbatim, keyed by header
  custom Json @default("{}")

  // enrichment / segmentation
  tier     String?
  score    Int?
  tags     String[] @default([])

  status   String  @default("new") // new | queued | contacted | replied | bounced | unsubscribed | invalid
  emailValid Boolean @default(true)
  dedupeKey  String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      LeadList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  messages  Message[]
  drafts    Draft[]

  @@index([workspaceId, status])
  @@index([listId])
  @@unique([workspaceId, dedupeKey])
}

// ─────────────────────────── Campaigns ───────────────────────────

model Campaign {
  id          String  @id @default(cuid())
  workspaceId String
  listId      String?
  name        String
  channel     String  @default("email") // email | whatsapp | both
  status      String  @default("draft") // draft | scheduled | running | paused | done

  // AI writer configuration
  aiEnabled   Boolean @default(false)
  aiPurpose   String? @db.Text  // "what am I mailing them about"
  aiTone      String  @default("direct, warm, no fluff")
  aiLanguage  String  @default("English")
  aiMaxWords  Int     @default(120)
  aiCta       String? @db.Text
  aiModel     String?

  // sending window (workspace timezone)
  sendDays    Int[]   @default([1,2,3,4,5])
  sendStartHour Int   @default(9)
  sendEndHour   Int   @default(18)
  timezone      String @default("Asia/Kolkata")
  perLeadGapHours Int @default(0)

  trackOpens  Boolean @default(true)
  trackClicks Boolean @default(true)
  stopOnReply Boolean @default(true)

  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      LeadList?      @relation(fields: [listId], references: [id])
  steps     CampaignStep[]
  messages  Message[]
  drafts    Draft[]
}

model CampaignStep {
  id         String @id @default(cuid())
  campaignId String
  order      Int
  channel    String @default("email") // email | whatsapp
  delayDays  Int    @default(0)       // wait after previous step
  subject    String? @db.Text
  body       String  @db.Text
  condition  String  @default("no_reply") // always | no_reply | no_open
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, order])
}

// AI-written, per-lead, reviewable BEFORE anything is sent
model Draft {
  id         String @id @default(cuid())
  campaignId String
  leadId     String
  stepOrder  Int    @default(1)
  channel    String @default("email")
  subject    String? @db.Text
  body       String  @db.Text
  model      String?
  approved   Boolean @default(false)
  edited     Boolean @default(false)
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId, stepOrder])
}

// ─────────────────────────── Messages & events ───────────────────────────

model Message {
  id          String @id @default(cuid())
  workspaceId String
  campaignId  String?
  leadId      String
  mailboxId   String?
  waInstanceId String?
  stepOrder   Int     @default(1)
  channel     String  @default("email")

  toAddress String
  subject   String? @db.Text
  body      String  @db.Text

  status     String  @default("queued") // queued | sent | failed | bounced | skipped
  providerId String?
  error      String? @db.Text

  scheduledFor DateTime @default(now())
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  repliedAt    DateTime?
  bouncedAt    DateTime?

  trackingId String @unique
  createdAt  DateTime @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailbox    Mailbox?    @relation(fields: [mailboxId], references: [id])
  waInstance WaInstance? @relation(fields: [waInstanceId], references: [id])
  events     Event[]

  @@index([status, scheduledFor])
  @@index([campaignId, status])
}

model Event {
  id        String   @id @default(cuid())
  messageId String
  type      String   // open | click | reply | bounce | complaint | unsubscribe | delivered
  meta      Json?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, type])
}

model Suppression {
  id          String   @id @default(cuid())
  workspaceId String
  value       String   // email or phone, lowercased
  kind        String   @default("email") // email | phone | domain
  reason      String   @default("unsubscribed")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, value])
}

model Template {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  channel     String @default("email")
  subject     String? @db.Text
  body        String  @db.Text
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Usage ───────────────────────────

/**
 * One append-only ledger for every metric worth billing or capping later
 * (ai_request, ai_tokens today; agent/task/message counters land here too as
 * those features ship) rather than a table per metric. `kind` + `meta` carry
 * the shape; aggregation is a GROUP BY, not a schema change.
 */
model UsageEvent {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String   // ai_request | ai_tokens | ...
  quantity    Int      @default(1)
  meta        Json?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, createdAt])
}

// DB-backed job queue — no Redis needed for v1
model Job {
  id          String   @id @default(cuid())
  workspaceId String
  type        String   // send_message | generate_drafts | sync_wa_status
  payload     Json
  status      String   @default("pending") // pending | running | done | failed
  runAt       DateTime @default(now())
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastError   String?  @db.Text
  lockedAt    DateTime?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}
